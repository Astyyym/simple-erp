# Python / Flask
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-win/
venv/

# Runtime business data - do not commit customer/order data
data/
logs/
temp_pdf/
backups/
imports/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# 本机可写配置：店铺名、打印偏移、主题、缩放都是每台机器的私有设置。
# 出厂默认配置的唯一真源是 packaging/default_config.json（构建打包 + 源码首次运行回退都用它）。
# 不要把这个文件提交回仓库，否则开发机设置会污染「厂默认」并持续漂移。
config.json

# Build outputs
dist/
build/
*.spec.bak

# Project process records - private working notes, not part of the public product.
# 这些是逐次执行过程记录（短计划、阶段状态、排障笔记），只留本地/私有仓库，不公开。
开发短计划/
task_plan.md
findings.md
progress.md

# Local temp / probe files
temp_*.py
temp_*.ps1
temp_*.md
temp_*.html
temp_*.pdf
*.log
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
.alma-snapshots

# 安卓原生客户端（native/）：构建产物与签名私密文件都不入库
# 细则见 native/.gitignore —— 这里不重复写，避免两处规则漂移。

# Alma 本地工作目录（临时 QA 脚本/截图，不入库）
.alma/
